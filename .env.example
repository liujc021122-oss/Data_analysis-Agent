# DeepSeek 官方 API 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Development/test use the local compatibility executor. Production must use
# an installed container image and the fail-closed container backend.
EXECUTION_BACKEND=local
EXECUTION_IMAGE=
EXECUTION_NETWORK_MODE=none

# 如需使用推理模型：
# OPENAI_MODEL=deepseek-reasoner
